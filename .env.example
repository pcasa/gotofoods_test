# Local non-Docker development (defaults to SQLite if DATABASE_URL is unset).
# Docker compose sets its own values; this file is for the uv/asdf dev path.
DATABASE_URL=postgres://menuapi:menuapi@localhost:5432/menuapi
DEBUG=true
SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser clients on other origins (e.g. a React dev server). Either list
# origins explicitly or set CORS_ALLOW_ALL_ORIGINS=true for local demos.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=false
